#!/bin/sh
set -eu
cd "$(git rev-parse --show-toplevel)"
# Validate exactly what is staged, including partially staged Rust files.
# A local target cache keeps repeated checks fast without touching the index.
staged=$(mktemp -d "${TMPDIR:-/tmp}/nysos-precommit.XXXXXX")
# Nix path inputs reject symlink components such as macOS /var -> /private/var.
staged=$(cd "$staged" && pwd -P)
trap 'rm -rf "$staged"' EXIT HUP INT TERM
git checkout-index --all --prefix="$staged/"
export CARGO_TARGET_DIR="$(pwd)/target/pre-commit"
cd "$staged"
# The exported index has no .git, so Nix can see every staged source file.
# Reuse the pinned environment even when Git is invoked outside nix develop.
nix develop "path:$staged" --no-write-lock-file --command make verify
